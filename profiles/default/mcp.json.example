{
  "$comment": [
    "Copy to mcp.json in this profile directory to activate. The entrypoint",
    "passes it to Claude Code with --mcp-config, so it is read straight from",
    "the host — no need to run `claude mcp add` inside the container.",
    "",
    "mcp.json is gitignored: MCP definitions routinely carry tokens. Keep the",
    "secret itself in .env and reference it as ${VAR} here — Claude Code expands",
    "environment variables in this file, so nothing sensitive is stored on disk",
    "in the repo. Add the matching passthrough to docker-compose.yml's",
    "environment: block so the variable actually reaches the container."
  ],
  "mcpServers": {
    "grafana": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-grafana"],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      }
    },
    "playwright": {
      "$comment": [
        "All three flags are required in this sandbox; the defaults do not work.",
        "--browser chromium: the default is the `chrome` channel, which the server",
        "  looks for at /opt/google/chrome/chrome — absent from this image.",
        "--headless: the server defaults to HEADED, and there is no X display.",
        "--output-dir: otherwise it drops .playwright-mcp/ and screenshots into the",
        "  repo root, i.e. into the user's bind-mounted workspace.",
        "One-time per browsers volume, `chromium` resolves to a chrome-for-testing",
        "build that is NOT the engine `npx playwright install chromium` provides:",
        "    npx @playwright/mcp install-browser chrome-for-testing"
      ],
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y", "@playwright/mcp@latest",
        "--browser", "chromium",
        "--headless",
        "--output-dir", "/tmp/playwright-mcp"
      ]
    }
  }
}
